            ]
          },
          "total_additional_costs": {
            "type": "string",
            "title": "Total Additional Costs"
          },
          "total_allocated": {
            "type": "string",
            "title": "Total Allocated"
          },
          "unallocated": {
            "type": "string",
            "title": "Unallocated"
          },
          "breakdown": {
            "items": {
              "$ref": "#/components/schemas/LandedCostBreakdown"
            },
            "type": "array",
            "title": "Breakdown"
          },
          "raw_costs": {
            "items": {
              "$ref": "#/components/schemas/CostResponse"
            },
            "type": "array",
            "title": "Raw Costs"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/LandedCostWarning"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "container",
          "base_currency",
          "allocation_method",
          "total_additional_costs",
          "total_allocated",
          "unallocated",
          "breakdown",
          "raw_costs",
          "warnings"
        ],
        "title": "LandedCostResponse"
      },
      "LandedCostWarning": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "LandedCostWarning"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
