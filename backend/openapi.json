    "/api/purchase-orders/upload": {
      "post": {
        "tags": [
          "purchase-orders"
        ],
        "summary": "Upload Po Csv",
        "description": "Legacy one-row-per-PO import.\n\nColumns: po_number, supplier_name, total_value, container_number, allocation_percentage.\n\nOne transaction. Rows with errors are skipped and reported; zero imported rows is a 422, not a success.",
        "operationId": "upload_po_csv_api_purchase_orders_upload_post",
        "parameters": [
          {
            "name": "X-Org-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
