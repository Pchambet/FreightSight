        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_invoice_api_containers__container_id__upload_invoice_post"
      },
      "Body_upload_po_csv_api_purchase_orders_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_po_csv_api_purchase_orders_upload_post"
      },
      "ContainerCreate": {
        "properties": {
          "container_number": {
            "type": "string",
            "maxLength": 11,
            "minLength": 11,
            "pattern": "^[A-Za-z]{4}[0-9]{7}$",
            "title": "Container Number"
          },
          "carrier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carrier"
          }
        },
        "type": "object",
        "required": [
          "container_number"
        ],
        "title": "ContainerCreate"
      },
      "ContainerResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "container_number": {
            "type": "string",
            "title": "Container Number"
          },
          "carrier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carrier"
          },
          "status": {
            "$ref": "#/components/schemas/ContainerStatus"
          }
        },
        "type": "object",
        "required": [
          "id",
          "container_number",
          "carrier",
          "status"
        ],
        "title": "ContainerResponse"
      },
      "ContainerStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "IN_TRANSIT",
          "DISCHARGED",
          "DELIVERED"
        ],
        "title": "ContainerStatus"
      },
      "ContainerUpdate": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ContainerStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "carrier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Carrier"
          }
        },
        "type": "object",
        "title": "ContainerUpdate"
      },
      "CostCreate": {
        "properties": {
          "cost_type": {
            "$ref": "#/components/schemas/CostType"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "cost_type",
          "amount",
          "currency"
        ],
        "title": "CostCreate"
      },
      "CostResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "cost_type": {
            "$ref": "#/components/schemas/CostType"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "id",
          "cost_type",
          "amount",
          "currency"
        ],
        "title": "CostResponse"
      },
      "CostType": {
        "type": "string",
        "enum": [
          "OCEAN_FREIGHT",
          "CUSTOMS",
          "DRAYAGE",
          "DEMURRAGE"
        ],
        "title": "CostType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "rows_processed": {
            "type": "integer",
            "title": "Rows Processed"
          },
          "rows_skipped": {
            "items": {
              "$ref": "#/components/schemas/ImportRowError"
            },
            "type": "array",
            "title": "Rows Skipped"
          },
          "purchase_orders_created": {
            "type": "integer",
            "title": "Purchase Orders Created"
          },
          "containers_created": {
            "type": "integer",
            "title": "Containers Created"
          },
          "containers_linked": {
            "type": "integer",
            "title": "Containers Linked"
          },
          "detected_columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Detected Columns"
          }
        },
        "type": "object",
        "required": [
          "status",
          "rows_processed",
          "rows_skipped",
          "purchase_orders_created",
          "containers_created",
          "containers_linked",
          "detected_columns"
        ],
        "title": "ImportResponse"
      },
      "ImportRowError": {
        "properties": {
          "row": {
            "type": "integer",
            "title": "Row"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "row",
          "code",
          "message"
        ],
        "title": "ImportRowError"
      },
      "LandedCostBreakdown": {
        "properties": {
          "po_id": {
            "type": "string",
            "format": "uuid",
            "title": "Po Id"
          },
          "po_number": {
            "type": "string",
            "title": "Po Number"
          },
          "supplier_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supplier Name"
          },
          "fob_value": {
            "type": "string",
            "title": "Fob Value"
          },
          "allocation_pct": {
            "type": "string",
            "title": "Allocation Pct"
          },
          "allocated_costs": {
            "type": "string",
            "title": "Allocated Costs"
          },
          "true_landed_cost": {
            "type": "string",
            "title": "True Landed Cost"
          }
        },
        "type": "object",
        "required": [
          "po_id",
          "po_number",
          "supplier_name",
          "fob_value",
          "allocation_pct",
          "allocated_costs",
          "true_landed_cost"
        ],
        "title": "LandedCostBreakdown"
      },
      "LandedCostResponse": {
        "properties": {
          "container": {
            "$ref": "#/components/schemas/ContainerResponse"
          },
          "base_currency": {
            "type": "string",
